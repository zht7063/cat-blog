# 复制为 .env 后修改，并执行 chmod 600 .env（密码是明文，D69）。
# 用 deploy/docker-compose.yml 部署时复制到 deploy/.env，否则放在运行 cat-blog 的目录里。
# 变量说明见 docs/v1.0-design.md §4 和 docs/v1.0-spec.md §10.1。

# 唯一管理员。改了用户名或密码后重启，所有已登录的会话失效。
ADMIN_USERNAME=admin
# 至少 12 个字符。
ADMIN_PASSWORD=

# 站点的公开地址。用于 RSS、sitemap 的绝对链接和登录时的 Origin 校验；https:// 时 cookie 带 Secure。
# deploy/ 里的 Caddy 也用它作为站点地址。
BASE_URL=https://blog.example.com

# 以下有默认值，一般不用改。Docker 镜像里 DATABASE_PATH 和 BIND_ADDR 已经设好。
# DATABASE_PATH=./data/cat-blog.db
# BIND_ADDR=127.0.0.1:3000
# 可信反向代理的 IP 段，逗号分隔；写成空值表示不信任任何代理。docker-compose.yml 里已设好。
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
# RUST_LOG=info

